---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostList from '@/components/PostList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="Journal">
  <main class="mx-auto my-[3em] w-prose max-w-[calc(100%-2em)] px-[1em]">
    <SectionHeading label="Journal" title="Journal" />
    <PostList entries={entries} basePath="/journal" />
  </main>
</BaseLayout>
