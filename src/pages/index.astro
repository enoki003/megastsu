---
/* Profile — 扉、略歴、主題、連絡先。ボタンも誘導文も置かない。 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Frame from '@/components/Frame.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';

const subjects = ['人工知能', '数学基礎論', '理論物理', '西洋哲学', '書評'];
const correspondence = [
  { key: 'Email', value: 'sonoyu1229@outlook.jp', href: 'mailto:sonoyu1229@outlook.jp' },
  { key: 'X', value: '@sonoyu1229', href: 'https://x.com/sonoyu1229' },
  { key: 'GitHub', value: 'enoki003', href: 'https://github.com/enoki003' },
  { key: 'Instagram', value: 'enoki003', href: 'https://www.instagram.com/enoki003/' },
];
---
<BaseLayout>
  <main class="mx-auto mb-[5em] w-prose max-w-[calc(100%-2em)] px-[1em]">
    <Frame filled={false}>
      <div class="flex min-h-[280px] flex-col items-center justify-center text-center">
        <div class="mb-[34px] font-garamond text-[12px] uppercase tracking-[var(--tracking-label)] text-ink-muted">Profile</div>
        <div>
          <div class="font-garamond text-[30px] leading-[1.35] tracking-[0.14em] text-ink">Yuhi Sonoki</div>
          <div class="mx-auto my-[22px] h-px w-[46px] bg-rule-inner"></div>
          <div class="font-mincho-body text-[13px] leading-[2] tracking-[0.1em] text-ink-muted">
            情報理工学部 在学<br />人工知能・数学基礎論
          </div>
        </div>
      </div>
    </Frame>

    <section class="mt-[4.5rem]">
      <header class="mb-[30px] text-center">
        <div class="mb-3 font-garamond text-[11px] uppercase tracking-[var(--tracking-label)] text-ink-muted">Biography</div>
        <h2 class="m-0 font-mincho-display [font-weight:var(--weight-title)] text-[18px] tracking-[0.24em] indent-[0.24em] text-ink">略歴</h2>
        <div class="mx-auto mt-4 w-[280px] border-b-[3px] border-double border-b-[rgb(var(--black)/.55)]"></div>
      </header>
      <p class="mx-auto max-w-[560px] font-mincho-body text-[15px] leading-[2.1] tracking-[0.06em] text-ink-body justify-ideograph">
        京都府立京都すばる高等学校 情報科学科を経て、京都産業大学 情報理工学部に在学。人工知能を主題としつつ、数学基礎論、理論物理、西洋哲学に関心を持つ。学問の分類は利便上のものであって、実際には全てが繋がっていると考えている。
      </p>
      <p class="mx-auto mt-[1.4rem] max-w-[560px] font-mincho-body text-[15px] leading-[2.1] tracking-[0.06em] text-ink-body justify-ideograph">
        本、背広、珈琲、骨董、散歩。昭和の文化を好み、昔ながらの良き紳士たらんと努めている。
      </p>
    </section>

    <section class="mt-[3.5rem]">
      <header class="mb-[30px] text-center">
        <div class="mb-3 font-garamond text-[11px] uppercase tracking-[var(--tracking-label)] text-ink-muted">Subjects</div>
        <h2 class="m-0 font-mincho-display [font-weight:var(--weight-title)] text-[18px] tracking-[0.24em] indent-[0.24em] text-ink">主題</h2>
        <div class="mx-auto mt-4 w-[280px] border-b-[3px] border-double border-b-[rgb(var(--black)/.55)]"></div>
      </header>
      <div class="flex flex-wrap justify-center gap-[10px]">
        {subjects.map((subject) => <Badge>{subject}</Badge>)}
      </div>
    </section>

    <section class="mt-[3.5rem] text-center">
      <header class="mb-[30px] text-center">
        <div class="mb-3 font-garamond text-[11px] uppercase tracking-[var(--tracking-label)] text-ink-muted">Correspondence</div>
        <h2 class="m-0 font-mincho-display [font-weight:var(--weight-title)] text-[18px] tracking-[0.24em] indent-[0.24em] text-ink">連絡先</h2>
        <div class="mx-auto mt-4 w-[280px] border-b-[3px] border-double border-b-[rgb(var(--black)/.55)]"></div>
      </header>
      <div class="inline-flex flex-col text-left">
        {correspondence.map(({ key, value, href }, i) => (
          <>
            <a
              href={href}
              target={href.startsWith('mailto') ? undefined : '_blank'}
              rel="noreferrer"
              class="flex items-baseline gap-[18px] py-[14px] no-underline"
            >
              <span class="min-w-0 flex-[0_0_128px] overflow-hidden font-garamond text-[13px] uppercase tracking-[var(--tracking-label)] text-ink-muted">{key}</span>
              <span class="min-w-0 flex-1 font-garamond text-[16px] tracking-[0.06em] text-fukamidori">{value}</span>
            </a>
            {i < correspondence.length - 1 && <Separator />}
          </>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
