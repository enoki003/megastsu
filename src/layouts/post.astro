---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro'

type Props = CollectionEntry<'notes'>['data'];

const { title, date } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={title} />
		<style is:global>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose mx-auto w-[720px] max-w-[calc(100%-2em)] p-4 text-foreground">
					<div class="mb-4 py-4 text-center leading-none">
						<h1 class="mb-2 border-t-0 pt-0">{title}</h1>
						<div class="mb-2 text-muted-foreground">
							<FormattedDate date={date} />
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
