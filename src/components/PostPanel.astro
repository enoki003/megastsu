---
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from './ui/card';

type Props = {
	href: string;
	title: string;
	date: Date;
	description?: string;
};

const { href, title, date, description } = Astro.props;
---

<a href={href} class="block no-underline">
	<Card className="gap-2">
		<CardHeader className="flex flex-row items-baseline justify-between gap-3 space-y-0">
			<CardTitle className="text-[1.05rem]">{title}</CardTitle>
			<time datetime={date.toISOString()} class="whitespace-nowrap text-sm text-muted-foreground">
				{date.toLocaleDateString('ja-JP')}
			</time>
		</CardHeader>
		{
			description ? (
				<CardContent>
					<CardDescription>{description}</CardDescription>
				</CardContent>
			) : null
		}
	</Card>
</a>
