---
/* 一覧の一枚。二重罫の中に表題・日付・説明文。日付は短い罫で挟む。 */
import Frame from './Frame.astro';
import FormattedDate from './FormattedDate.astro';
interface Props {
  href: string;
  title: string;
  date: Date | string;
  description?: string;
}
const { href, title, date, description } = Astro.props;
---
<Frame as="article" raised={true}>
  <a href={href} class="block no-underline text-inherit">
    <h2 class="m-0 font-mincho-display [font-weight:var(--weight-title)] text-[var(--text-card-title)] leading-[1.55] tracking-[0.1em] text-center text-ink">{title}</h2>
    <div class="mt-4 flex items-center justify-center gap-[14px]">
      <span class="h-px w-[30px] bg-rule-inner"></span>
      <span class="text-[13px]"><FormattedDate date={date} /></span>
      <span class="h-px w-[30px] bg-rule-inner"></span>
    </div>
    {description && (
      <p class="mt-[18px] mb-0 font-mincho-body text-[14px] leading-[1.9] tracking-[0.05em] text-ink-body justify-ideograph">{description}</p>
    )}
  </a>
</Frame>
